[Unit]
Description=Setryn Arbitrum Sepolia maker refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/setryn
Environment=NODE_ENV=production
EnvironmentFile=/etc/setryn/maker-refresh.env
ExecStart=/usr/bin/flock --wait 180 /run/lock/setryn-wallet.lock /usr/bin/node scripts/run-sepolia-maker-refresh.mjs
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=setryn
MemoryHigh=128M
MemoryMax=256M
