[Unit]
Description=Setryn market-data ingester (Chainlink rounds, fills and positions into Postgres)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/setryn
Environment=NODE_ENV=production
EnvironmentFile=/etc/setryn/market-data.env
# Long-running: it resumes from its database cursors after any restart, and SIGTERM finishes the current pass.
ExecStart=/usr/bin/node --experimental-strip-types --no-warnings services/market-data-ingester/src/bin/ingest.ts --environment arbitrum-sepolia
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
