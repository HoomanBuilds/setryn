# /etc/setryn/market-data.env for the market-data ingester (owner ubuntu, mode 0600). Copy, fill in, never commit.

# AWS RDS Postgres. SSL is required for any non-loopback host.
SETRYN_DATABASE_URL=postgres://setryn_admin:<password>@<rds-endpoint>:5432/setryn?sslmode=require
SETRYN_DATABASE_POOL_SIZE=4

# The deployment the fills and positions come from (its runtime and manifest default to deployments/<network>/).
SETRYN_NETWORK=arbitrum-sepolia
SETRYN_RPC_URL=https://<arbitrum-sepolia-rpc>

# Arbitrum One, read-only: Chainlink rounds are read with eth_call and nothing is ever sent there.
SETRYN_REFERENCE_RPC_URL=https://<arbitrum-one-rpc>

# How far back Chainlink history is backfilled, blocks held back from the head, and the pass interval.
SETRYN_INGEST_BACKFILL_DAYS=180
SETRYN_INGEST_CONFIRMATIONS=3
SETRYN_INGEST_INTERVAL_SECONDS=15
