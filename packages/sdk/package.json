{
  "name": "@setryn/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Setryn public API: market data, account projections, and non-custodial EIP-712 order entry and private RFQ.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "example:read": "node --experimental-strip-types --no-warnings examples/read-markets.ts",
    "example:order": "node --experimental-strip-types --no-warnings examples/place-devnet-order.ts",
    "example:rfq": "node --experimental-strip-types --no-warnings examples/private-rfq.ts"
  },
  "dependencies": {
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "typescript": "^5.8.2"
  }
}
