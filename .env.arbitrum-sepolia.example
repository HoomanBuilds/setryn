# Arbitrum Sepolia: contract deployment, market bootstrap and the operator worker.
# Copy to .env.arbitrum-sepolia (never commit the filled copy), then `set -a; source .env.arbitrum-sepolia; set +a`.
# Step-by-step commands: docs/runbooks/network-deployment.md. Arbitrum One is refused by every script and the worker.

# --- RPC ---------------------------------------------------------------------------------------------------------
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Arbitrum One, read-only eth_call: Chainlink references for strikes, maker prices and signed fixings.
SETRYN_REFERENCE_RPC_URL=https://arb1.arbitrum.io/rpc
ETHERSCAN_API_KEY=

# --- 1. Core deployment (contracts/script/DeploySetryn.s.sol) ----------------------------------------------------
SETRYN_DEPLOYMENT_ENVIRONMENT=arbitrum-sepolia
# Address of the key that broadcasts the deployment. SETRYN_INITIAL_ADMIN must equal it for the wiring phase.
SETRYN_DEPLOYER_ADDRESS=
SETRYN_INITIAL_ADMIN=
# Protocol principals (distinct addresses; use Safes for governance and treasury).
SETRYN_GOVERNANCE_ADMIN=
SETRYN_GOVERNANCE_OPERATOR=
SETRYN_GUARDIAN=
SETRYN_EXCESS_RECOVERY_OPERATOR=
SETRYN_PRIVACY_KEY_PUBLISHER=
SETRYN_LIFECYCLE_WITNESS_STAGER=
# Controls the protocol fee account; withdrawals go through it only.
SETRYN_TREASURY_CONTROLLER=
# 32-byte hex, unique per deployment: 0x$(openssl rand -hex 32)
SETRYN_DEPLOYMENT_ID=
SETRYN_EVALUATION_GAS_HARD_CAP=2000000
# Arbitrum Sepolia has no official Chainlink sequencer uptime feed. "testnet-static" deploys a static feed and is
# accepted on chain 421614 only; on any other network give a real feed address.
SETRYN_SEQUENCER_UPTIME_FEED=testnet-static
SETRYN_DEFAULT_ADMIN_DELAY=172800
SETRYN_MAX_LOCK_DURATION=2592000
SETRYN_MAXIMUM_RISK_ADAPTER_GAS=500000
SETRYN_MAXIMUM_RISK_OBSERVATION_AGE=300
SETRYN_OPERATIONAL_READ_GAS=500000
SETRYN_OPERATIONAL_EXECUTION_GAS=800000
SETRYN_MAXIMUM_ORDER_LIFETIME=2592000
SETRYN_MAXIMUM_RFQ_CAPACITY_TAIL=86400
SETRYN_SEQUENCER_RECOVERY_GRACE=3600

# --- 2. Market bootstrap (contracts/script/BootstrapSetrynMarkets.s.sol) ---------------------------------------
# Core addresses (SETRYN_ASSET_REGISTRY ... SETRYN_SIGNED_LIFECYCLE_ENGINE, SETRYN_DEPLOYMENT_BLOCK) come from
#   eval "$(node scripts/network-bootstrap-env.mjs --manifest deployments/arbitrum-sepolia/manifest.json \
#     --broadcast contracts/broadcast/DeploySetryn.s.sol/421614/run-latest.json)"
# Absolute paths; the listing comes from `node scripts/generate-network-markets.mjs --network arbitrum-sepolia`.
SETRYN_MARKET_LISTING=
SETRYN_RUNTIME_OUTPUT=
SETRYN_SESSION_DAYS_OUTPUT=
# Empty deploys Setryn Test USDC. Circle test USDC remains the only accepted override.
SETRYN_SETTLEMENT_TOKEN=
# Fixing publishers (comma-separated addresses, strictly increasing) and the signatures each fixing needs.
SETRYN_ORACLE_SIGNERS=
SETRYN_ORACLE_THRESHOLD=1
# true only when the treasury controller's key also signs the bootstrap run; otherwise accept from the Safe afterwards.
SETRYN_TREASURY_ACCEPT_CONTROL=false

# --- 3. Operator worker (services/operator-runtime) -------------------------------------------------------------
# Run on a schedule: pnpm --filter @setryn/operator-runtime worker --environment arbitrum-sepolia --sweep true
# Publishes session days, relays signed Chainlink fixings, and settles and resolves positions.
SETRYN_OPERATOR_ENVIRONMENT=arbitrum-sepolia
SETRYN_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# 32-byte hex keys, kept out of git. The operator key holds SETRYN_GOVERNANCE_OPERATOR's roles; the oracle key must be
# one of SETRYN_ORACLE_SIGNERS. Fund both with Sepolia ETH.
SETRYN_SEPOLIA_OPERATOR_KEY=
SETRYN_ORACLE_SIGNER_KEY=
# Defaults: deployments/arbitrum-sepolia/runtime.json and manifest.json.
SETRYN_SEPOLIA_RUNTIME_PATH=
SETRYN_SEPOLIA_MANIFEST_PATH=

# Signing keys for Forge are passed on the command line (--private-key / --private-keys) or from a keystore, never
# stored here. Simulation is the default; add --broadcast only after reviewing the simulated run.
