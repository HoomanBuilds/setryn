# Local development. Copy to .env (never commit the filled copy). Network deployment: .env.arbitrum-sepolia.example.
# Web app settings live in apps/web/.env.example.

# --- RPC ---------------------------------------------------------------------------------------------------------
# Public defaults are rate limited; fine for read-only development.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_FORK_BLOCK_NUMBER=
LOCAL_RPC_URL=http://127.0.0.1:8545
# Arbitrum One, read-only: Chainlink references for listings, maker prices and fixings.
SETRYN_REFERENCE_RPC_URL=https://arb1.arbitrum.io/rpc
ETHERSCAN_API_KEY=

# --- Local chain (scripts/local-deploy-reset.sh) -----------------------------------------------------------------
# The reset starts anvil, deploys the core, lists markets from live Chainlink prices and bootstraps them, writing
# deployments/local/{runtime,session-days,manifest}.json. Principals are the anvil development accounts.
# Optional chain start time (ISO-8601 UTC); defaults to now.
SETRYN_DEVNET_EPOCH=
# Overrides for a second, isolated local chain.
SETRYN_LOCAL_STATE_DIR=
SETRYN_LOCAL_DEPLOYMENT_DIR=
SETRYN_LOCAL_BROADCAST_DIR=

# --- Core deployment inputs (non-secret; signers go to Forge separately) ----------------------------------------
SETRYN_DEPLOYMENT_ENVIRONMENT=local
SETRYN_DEPLOYER_ADDRESS=
SETRYN_INITIAL_ADMIN=
SETRYN_DEFAULT_ADMIN_DELAY=172800
SETRYN_MAX_LOCK_DURATION=2592000
SETRYN_EVALUATION_GAS_HARD_CAP=
SETRYN_DEPLOYMENT_ID=
SETRYN_MAXIMUM_RISK_ADAPTER_GAS=500000
SETRYN_MAXIMUM_RISK_OBSERVATION_AGE=300
SETRYN_OPERATIONAL_READ_GAS=500000
SETRYN_OPERATIONAL_EXECUTION_GAS=800000

# --- Operator worker on the local chain ---------------------------------------------------------------------------
# pnpm --filter @setryn/operator-runtime worker --environment local --sweep true
# Locally the operator and oracle signer default to the anvil accounts the deployment used.
SETRYN_OPERATOR_ENVIRONMENT=local
SETRYN_RUNTIME_PATH=
SETRYN_ORACLE_SIGNER_KEY=
