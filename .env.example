# Public RPC defaults are suitable for read-only development and may be rate limited.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_FORK_BLOCK_NUMBER=
LOCAL_RPC_URL=http://127.0.0.1:8545
ETHERSCAN_API_KEY=

# Non-secret deployment inputs. Signer configuration is supplied separately to Forge.
SETRYN_DEPLOYMENT_ENVIRONMENT=local
SETRYN_DEPLOYER_ADDRESS=
SETRYN_INITIAL_ADMIN=
SETRYN_DEFAULT_ADMIN_DELAY=172800
SETRYN_MAX_LOCK_DURATION=2592000
SETRYN_EVALUATION_GAS_HARD_CAP=
