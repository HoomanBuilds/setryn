# Public browser settings for the web app. Copy to .env.local and fill in what you need; every NEXT_PUBLIC_ value is
# inlined into the client bundle at build time, so none of these may be secrets.

# WalletConnect (Reown) Cloud project id. When set, the connect prompt also offers WalletConnect for mobile and other
# wallets; when empty, only injected (EIP-6963) wallets, Coinbase Wallet and Safe are offered. Create one at
# https://cloud.reown.com and allow this app's origin there.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC the wallet uses for the local Setryn chain (31337) when it adds the network. Defaults to http://127.0.0.1:8545.
NEXT_PUBLIC_SETRYN_LOCAL_RPC_URL=
