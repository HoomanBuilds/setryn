# Web app settings. Copy to .env.local and fill in what you need (docs/plans/network-runtime-real-data.md, section 5).
# Every NEXT_PUBLIC_ value is inlined into the client bundle at build time, so none of those may be secrets. Server
# values (no NEXT_PUBLIC_ prefix) stay on the server; the private keys below must never be committed.

# --- Network -------------------------------------------------------------------------------------------------------

# Deployment network: local (default), arbitrum-sepolia or arbitrum-one. Selects deployments/<network>/runtime.json,
# the chain the wallet connects on, and which controls exist. next.config.ts copies it into NEXT_PUBLIC_SETRYN_NETWORK
# for the browser, so setting this one is enough; set NEXT_PUBLIC_SETRYN_NETWORK only to override the browser's copy.
SETRYN_NETWORK=
NEXT_PUBLIC_SETRYN_NETWORK=

# Runtime file to read instead of deployments/<network>/runtime.json (web and services). Its chain must match the
# network; schemas 9, 10 and 11 are accepted.
SETRYN_RUNTIME_PATH=

# --- RPC -----------------------------------------------------------------------------------------------------------

# Server RPC for chain reads and the platform's own transactions. Defaults: http://127.0.0.1:8545 locally (loopback
# http only), https://sepolia-rollup.arbitrum.io/rpc on Arbitrum Sepolia, https://arb1.arbitrum.io/rpc on Arbitrum One
# (https only on a network). It may carry a provider key: it is never sent to the browser.
SETRYN_RPC_URL=

# RPC the wallet and browser reads use. Defaults to the network's public RPC (locally, the server's loopback node). Use
# a key-restricted or public endpoint: it is visible to every visitor.
NEXT_PUBLIC_SETRYN_RPC_URL=

# RPC the wallet uses for the local chain (31337) when it adds the network. Defaults to NEXT_PUBLIC_SETRYN_RPC_URL, else
# http://127.0.0.1:8545.
NEXT_PUBLIC_SETRYN_LOCAL_RPC_URL=

# Arbitrum One RPC for Chainlink reference prices (read-only eth_call on every network). Defaults to
# https://arb1.arbitrum.io/rpc.
SETRYN_REFERENCE_RPC_URL=

# --- Platform signers (server only, networks only) -----------------------------------------------------------------
# Locally the platform signs with the local node's unlocked deployment accounts and these are ignored. On a network
# each role is unavailable until its key is set; the routes that need it answer 503 with OPERATOR_SIGNER_UNCONFIGURED
# or MAKER_SIGNER_UNCONFIGURED. Keys are never logged or returned. Fund each address with ETH for gas.

# Operator role: risk admission for orders, RFQ handoff execution (MATCH_EXECUTOR_ROLE), lifecycle witness staging
# (WITNESS_STAGER_ROLE) and keeper calls. 32-byte hex private key.
SETRYN_OPERATOR_PRIVATE_KEY=

# Optional designated maker: rests two-sided quotes priced from the Chainlink reference, answers RFQs, and consents to
# exits of positions it is the counterparty of. Without it no house quotes are posted. Fund it by sending USDC to its
# address; the next liquidity refresh deposits whatever USDC the wallet holds.
SETRYN_MAKER_PRIVATE_KEY=

# Arbitrum One stays read-only for the server's signers until mainnet writes are explicitly authorized. Set to
# "authorized" only with that authorization; any other value keeps both roles unavailable on Arbitrum One.
SETRYN_MAINNET_WRITES=

# Publisher key for signed fixings, used by the operator runtime (services/operator-runtime), not by the web app. Must
# be one of the runtime's oracleSigners.
SETRYN_ORACLE_SIGNER_KEY=

# --- Wallets -------------------------------------------------------------------------------------------------------

# WalletConnect (Reown) Cloud project id. When set, the connect prompt also offers WalletConnect for mobile and other
# wallets; when empty, only injected (EIP-6963) wallets, Coinbase Wallet and Safe are offered. Create one at
# https://cloud.reown.com and allow this app's origin there.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
