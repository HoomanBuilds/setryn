# Web app against the Arbitrum Sepolia deployment. Copy to apps/web/.env.local (or set these on your host) after
# deployments/arbitrum-sepolia/runtime.json exists; `predev`/`prebuild` sync the market catalog from it.
# Every variable is explained in apps/web/.env.example. Keys stay server-side and must never be committed.

SETRYN_NETWORK=arbitrum-sepolia

# Server RPC (may carry a provider key; never sent to the browser) and the browser RPC (public or key-restricted).
SETRYN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_SETRYN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Arbitrum One, read-only: Chainlink reference prices.
SETRYN_REFERENCE_RPC_URL=https://arb1.arbitrum.io/rpc

# Operator role (risk admission, RFQ execution, witness staging, tUSDC faucet mints): the SETRYN_GOVERNANCE_OPERATOR
# key. Required; fund it with Sepolia ETH. The faucet grants 10,000 tUSDC per request with no cooldown, up to 10M per
# wallet, and never sends ETH.
SETRYN_OPERATOR_PRIVATE_KEY=
# Optional designated maker: firm bid and ask quotes on every market from the Chainlink reference, signed offchain and
# streamed to the terminal with no transaction per quote; a taker settles one in a single router transaction. Its only
# recurring transaction locks a series' quote capacity once per three-day epoch, when the series is first viewed. It mints
# its own tUSDC collateral; fund its address with Sepolia ETH for those capacity transactions.
SETRYN_MAKER_PRIVATE_KEY=
# Optional relayer: submits users' signed settlements so trading is gasless for them (no fee). Its own key and nonce
# lane; without it users submit from their wallet. Fund its address with Sepolia ETH.
SETRYN_RELAYER_PRIVATE_KEY=

# Public origin(s) the app is served from, comma separated (embeds and partner widgets trust these as Setryn's own).
SETRYN_PUBLIC_ORIGIN=

# WalletConnect (Reown) project id; optional.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Persistent data directories (organization control, API keys, webhooks). Point them at durable storage in production.
SETRYN_ORG_STORE_PATH=
SETRYN_PUBLIC_API_DIR=
SETRYN_WEBHOOKS_DIR=

# Use the Supabase transaction-pooler URL on Vercel. AWS workers use the session-pooler URL. Also serializes the
# designated maker's transactions across server instances (an advisory lock; no extra table).
SETRYN_DATABASE_URL=
