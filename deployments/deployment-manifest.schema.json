{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setryn.local/schemas/deployment-manifest.schema.json",
  "title": "Setryn deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "chainId",
    "status",
    "generatedAt",
    "sourceCommit",
    "blockReference",
    "compiler",
    "broadcast",
    "phase2",
    "contracts",
    "externalDependencies"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0.0"},
    "environment": {"enum": ["local", "arbitrum-sepolia", "arbitrum-one"]},
    "chainId": {"type": "integer", "minimum": 1},
    "status": {"enum": ["planned", "simulated", "broadcast", "disabled"]},
    "generatedAt": {"type": ["string", "null"], "format": "date-time"},
    "sourceCommit": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "blockReference": {"$ref": "#/$defs/blockReference"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "broadcast": {"$ref": "#/$defs/broadcast"},
    "phase2": {"$ref": "#/$defs/phase2"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contract"}
    },
    "externalDependencies": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalDependency"}
    },
    "linkedLibraries": {
      "type": "array",
      "items": {"$ref": "#/$defs/linkedLibrary"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"environment": {"const": "arbitrum-one"}}},
      "then": {
        "properties": {
          "chainId": {"const": 42161},
          "status": {"const": "disabled"},
          "broadcast": {
            "properties": {
              "enabled": {"const": false},
              "signed": {"const": false},
              "transactionCount": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {"const": "arbitrum-sepolia"},
          "status": {"const": "planned"}
        },
        "required": ["environment", "status"]
      },
      "then": {
        "properties": {
          "chainId": {"const": 421614},
          "broadcast": {
            "properties": {
              "enabled": {"const": false},
              "signed": {"const": false},
              "transactionCount": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "broadcast"}}},
      "then": {
        "properties": {
          "generatedAt": {"type": "string", "format": "date-time"},
          "blockReference": {
            "properties": {
              "number": {"type": "integer", "minimum": 0},
              "hash": {"$ref": "#/$defs/bytes32"},
              "mode": {"const": "broadcast"}
            }
          },
          "broadcast": {
            "properties": {
              "enabled": {"const": true},
              "transactionCount": {"type": "integer", "minimum": 1}
            }
          },
          "contracts": {
            "items": {
              "properties": {
                "address": {"$ref": "#/$defs/address"},
                "bytecode": {
                  "properties": {
                    "creationCodeHash": {"$ref": "#/$defs/bytes32"},
                    "runtimeCodeHash": {"$ref": "#/$defs/bytes32"}
                  }
                },
                "deploymentTransaction": {
                  "properties": {
                    "hash": {"$ref": "#/$defs/bytes32"},
                    "blockNumber": {"type": "integer", "minimum": 0},
                    "broadcast": {"const": true}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "nullableAddress": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/address"}]
    },
    "bytes32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "nullableBytes32": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/bytes32"}]
    },
    "blockReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "hash", "mode"],
      "properties": {
        "number": {"type": ["integer", "null"], "minimum": 0},
        "hash": {"$ref": "#/$defs/nullableBytes32"},
        "mode": {"enum": ["planned", "simulation", "pinned", "current", "broadcast"]}
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "evmVersion", "optimizer", "bytecodeHashMode"],
      "properties": {
        "name": {"const": "solc"},
        "version": {"type": "string", "minLength": 1},
        "evmVersion": {"type": "string", "minLength": 1},
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "runs"],
          "properties": {
            "enabled": {"type": "boolean"},
            "runs": {"type": "integer", "minimum": 0}
          }
        },
        "bytecodeHashMode": {"type": "string", "minLength": 1}
      }
    },
    "broadcast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "signed", "transactionCount"],
      "properties": {
        "enabled": {"type": "boolean"},
        "signed": {"type": "boolean"},
        "transactionCount": {"type": "integer", "minimum": 0}
      }
    },
    "phase2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoryFile", "contracts", "deployments", "bootstrapAuthority", "finalPrincipals", "qualificationEvidence", "activationPolicy", "mainnetBroadcastAllowed"],
      "properties": {
        "inventoryFile": {"const": "../phase2-contract-inventory.json"},
        "contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "deployments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "artifact", "address", "runtimeCodeHash", "configurationHash", "capabilityHash", "evidenceHash", "transactionHash", "blockNumber", "constructorArguments", "dependencies", "roleAuthority", "supported", "disabled", "activation"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "artifact": {"type": "string", "minLength": 1},
              "address": {"$ref": "#/$defs/address"},
              "runtimeCodeHash": {"$ref": "#/$defs/bytes32"},
              "configurationHash": {"$ref": "#/$defs/bytes32"},
              "capabilityHash": {"$ref": "#/$defs/bytes32"},
              "evidenceHash": {"$ref": "#/$defs/bytes32"},
              "transactionHash": {"$ref": "#/$defs/bytes32"},
              "blockNumber": {"type": "integer", "minimum": 0},
              "constructorArguments": {"type": "array", "items": {}},
              "linkedLibraries": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "roleAuthority": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "supported": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "disabled": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "activation": {"enum": ["planned", "qualified", "blocked"]}
            }
          }
        },
        "bootstrapAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "postWiringRevocationRequired"],
          "properties": {
            "source": {"const": "SETRYN_DEPLOYER_ADDRESS"},
            "postWiringRevocationRequired": {"const": true}
          }
        },
        "finalPrincipals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["governanceAdmin", "governanceOperator", "guardian", "excessRecoveryOperator", "privacyKeyPublisher", "lifecycleWitnessStager"],
          "properties": {
            "governanceAdmin": {"$ref": "#/$defs/principal"},
            "governanceOperator": {"$ref": "#/$defs/principal"},
            "guardian": {"$ref": "#/$defs/principal"},
            "excessRecoveryOperator": {"$ref": "#/$defs/principal"},
            "privacyKeyPublisher": {"$ref": "#/$defs/principal"},
            "lifecycleWitnessStager": {"$ref": "#/$defs/principal"}
          }
        },
        "qualificationEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constructorDependencies", "configurationHash", "capabilityHash", "roleAssignments", "activation", "supportedCapabilities", "disabledCapabilities", "postWiringEvidenceHash", "bootstrapRolesRevoked", "adminTransfersBegun"],
          "properties": {
            "constructorDependencies": {"type": "string", "minLength": 1},
            "configurationHash": {"$ref": "#/$defs/nullableBytes32"},
            "capabilityHash": {"$ref": "#/$defs/nullableBytes32"},
            "roleAssignments": {"type": "string", "minLength": 1},
            "activation": {"enum": ["planned", "qualified", "blocked"]},
            "supportedCapabilities": {"type": "string", "minLength": 1},
            "disabledCapabilities": {"type": "string", "minLength": 1},
            "postWiringEvidenceHash": {"$ref": "#/$defs/nullableBytes32"},
            "bootstrapRolesRevoked": {"type": "boolean"},
            "adminTransfersBegun": {"type": "boolean"}
          }
        },
        "activationPolicy": {"const": "registered-paused-until-qualified"},
        "mainnetBroadcastAllowed": {"const": false}
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "source"],
      "properties": {
        "address": {"$ref": "#/$defs/nullableAddress"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "constructorArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "value": {}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "members"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/$defs/nullableBytes32"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/principal"}}
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "value": {"type": ["integer", "string", "null"]}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "artifact",
        "address",
        "implementation",
        "constructorArguments",
        "bytecode",
        "deploymentTransaction",
        "owner",
        "roles",
        "caps",
        "dependencies"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "address": {"$ref": "#/$defs/nullableAddress"},
        "implementation": {"$ref": "#/$defs/nullableAddress"},
        "constructorArguments": {
          "type": "array",
          "items": {"$ref": "#/$defs/constructorArgument"}
        },
        "bytecode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["creationCodeHash", "runtimeCodeHash"],
          "properties": {
            "creationCodeHash": {"$ref": "#/$defs/nullableBytes32"},
            "runtimeCodeHash": {"$ref": "#/$defs/nullableBytes32"}
          }
        },
        "deploymentTransaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "blockNumber", "broadcast"],
          "properties": {
            "hash": {"$ref": "#/$defs/nullableBytes32"},
            "blockNumber": {"type": ["integer", "null"], "minimum": 0},
            "broadcast": {"type": "boolean"}
          }
        },
        "owner": {"$ref": "#/$defs/principal"},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
        "caps": {"type": "array", "items": {"$ref": "#/$defs/cap"}},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "linkedLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact", "address", "creationCodeHash", "runtimeCodeHash", "transactionHash", "blockNumber", "linkedLibraries", "linkedBy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "address": {"$ref": "#/$defs/address"},
        "creationCodeHash": {"$ref": "#/$defs/bytes32"},
        "runtimeCodeHash": {"$ref": "#/$defs/bytes32"},
        "transactionHash": {"$ref": "#/$defs/bytes32"},
        "blockNumber": {"type": "integer", "minimum": 0},
        "linkedLibraries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "linkedBy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "externalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "purpose",
        "provenance",
        "runtimeCodeHash",
        "qualificationStatus",
        "consumers"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "address": {"$ref": "#/$defs/nullableAddress"},
        "purpose": {"type": "string", "minLength": 1},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "verifiedAt"],
          "properties": {
            "kind": {"enum": ["official-documentation", "onchain-registry", "operator-attestation"]},
            "reference": {"type": "string", "minLength": 1},
            "verifiedAt": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "runtimeCodeHash": {"$ref": "#/$defs/nullableBytes32"},
        "qualificationStatus": {"enum": ["pending", "code-hash-recorded", "qualified", "rejected"]},
        "consumers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
